{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__NODE__",
            "args": ["__PASTA_CLAUDE__/hooks/equipe-boletim.mjs"],
            "timeout": 15
          },
          {
            "type": "command",
            "command": "__NODE__",
            "args": ["__PASTA_CLAUDE__/hooks/equipe-memoria.mjs"],
            "timeout": 20
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "Explore|verificador|revisor",
        "hooks": [
          {
            "type": "command",
            "command": "__NODE__",
            "args": ["__PASTA_CLAUDE__/hooks/equipe-contexto.mjs"],
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*__execute_sql",
        "hooks": [
          {
            "type": "command",
            "command": "__NODE__",
            "args": ["__PASTA_CLAUDE__/hooks/equipe-sql.mjs"],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "__NODE__",
            "args": ["__PASTA_CLAUDE__/hooks/equipe-banco.mjs"],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "__NODE__",
            "args": ["__PASTA_CLAUDE__/hooks/equipe-segredos.mjs"],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "__NODE__",
            "args": ["__PASTA_CLAUDE__/hooks/equipe-segredos.mjs"],
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__NODE__",
            "args": ["__PASTA_CLAUDE__/hooks/equipe-aviso.mjs"],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__NODE__",
            "args": ["__PASTA_CLAUDE__/hooks/equipe-memoria.mjs"],
            "timeout": 20
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__NODE__",
            "args": ["__PASTA_CLAUDE__/hooks/equipe-memoria.mjs"],
            "timeout": 20
          }
        ]
      }
    ]
  }
}
