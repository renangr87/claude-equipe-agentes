{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__NODE__",
            "args": [
              "__PASTA_CLAUDE__/hooks/equipe-boletim.mjs"
            ],
            "timeout": 15
          },
          {
            "type": "command",
            "command": "__NODE__",
            "args": [
              "__PASTA_CLAUDE__/hooks/equipe-memoria.mjs"
            ],
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__NODE__",
            "args": [
              "__PASTA_CLAUDE__/hooks/equipe-eventos.mjs"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "Explore|verificador|revisor",
        "hooks": [
          {
            "type": "command",
            "command": "__NODE__",
            "args": [
              "__PASTA_CLAUDE__/hooks/equipe-contexto.mjs"
            ],
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "implementador",
        "hooks": [
          {
            "type": "command",
            "command": "__NODE__",
            "args": [
              "__PASTA_CLAUDE__/hooks/equipe-eventos.mjs"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit|Read|Grep|Glob|Agent|Task|mcp__.*__execute_sql",
        "hooks": [
          {
            "type": "command",
            "command": "__NODE__",
            "args": [
              "__PASTA_CLAUDE__/hooks/equipe-pre.mjs"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit|Agent|Task|mcp__codebase-memory__.*",
        "hooks": [
          {
            "type": "command",
            "command": "__NODE__",
            "args": [
              "__PASTA_CLAUDE__/hooks/equipe-pos.mjs"
            ],
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "__NODE__",
            "args": [
              "__PASTA_CLAUDE__/hooks/equipe-pos.mjs"
            ],
            "timeout": 20
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "Explore|revisor|implementador",
        "hooks": [
          {
            "type": "command",
            "command": "__NODE__",
            "args": [
              "__PASTA_CLAUDE__/hooks/equipe-eventos.mjs"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__NODE__",
            "args": [
              "__PASTA_CLAUDE__/hooks/equipe-aviso.mjs"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__NODE__",
            "args": [
              "__PASTA_CLAUDE__/hooks/equipe-eventos.mjs"
            ],
            "timeout": 15
          },
          {
            "type": "command",
            "command": "__NODE__",
            "args": [
              "__PASTA_CLAUDE__/hooks/equipe-memoria.mjs"
            ],
            "timeout": 20
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__NODE__",
            "args": [
              "__PASTA_CLAUDE__/hooks/equipe-memoria.mjs"
            ],
            "timeout": 20
          }
        ]
      }
    ]
  }
}
